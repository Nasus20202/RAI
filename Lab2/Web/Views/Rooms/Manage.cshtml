@{
    ViewData["Title"] = "Manage Rooms";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-door-open"></i> Room Management</h2>
            <p class="text-muted">Manage all rooms in the system</p>
        </div>
    </div>

    <!-- Success/Error Messages -->
    <div id="messageContainer"></div>

    <!-- Add New Room Form -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-plus-circle"></i> Add New Room
                    </h5>
                </div>
                <div class="card-body">
                    <form id="createRoomForm" class="row g-3">
                        <div class="col-md-6">
                            <label for="Name" class="form-label">
                                <i class="bi bi-tag"></i> Room Name *
                            </label>
                            <input type="text" 
                                   class="form-control" 
                                   id="Name" 
                                   name="Name" 
                                   placeholder="e.g., Conference Room A"
                                   required 
                                   maxlength="100" />
                            <div class="form-text">Unique name for the room</div>
                        </div>
                        
                        <div class="col-md-4">
                            <label for="Capacity" class="form-label">
                                <i class="bi bi-people"></i> Capacity *
                            </label>
                            <input type="number" 
                                   class="form-control" 
                                   id="Capacity" 
                                   name="Capacity" 
                                   placeholder="e.g., 10"
                                   required 
                                   min="1" 
                                   max="1000" />
                            <div class="form-text">Maximum number of people</div>
                        </div>
                        
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-check-circle"></i> Add Room
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Existing Rooms List -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-list"></i> Existing Rooms (<span id="roomCount">0</span>)
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Loading Spinner -->
                    <div id="loadingSpinner" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading rooms...</p>
                    </div>

                    <!-- Rooms Table -->
                    <div id="roomsTableContainer" style="display: none;">
                        <!-- Table will be inserted here by JavaScript -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this room?</p>
                <div class="alert alert-warning">
                    <i class="bi bi-info-circle"></i> 
                    <strong>Room:</strong> <span id="roomNameDisplay"></span>
                </div>
                <p class="text-danger mb-0">
                    <small>
                        <i class="bi bi-exclamation-triangle"></i> 
                        <strong>Warning:</strong> This will also delete all reservations associated with this room!
                    </small>
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete Room
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/manage-rooms.js"></script>
}
