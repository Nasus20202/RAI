@model Lab2.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center p-5">
                    @if (Model.StatusCode == 403)
                    {
                        <i class="bi bi-shield-lock text-warning" style="font-size: 5rem;"></i>
                        <h1 class="display-1 fw-bold text-warning">403</h1>
                    }
                    else if (Model.StatusCode == 404)
                    {
                        <i class="bi bi-exclamation-triangle text-warning" style="font-size: 5rem;"></i>
                        <h1 class="display-1 fw-bold text-warning">404</h1>
                    }
                    else if (Model.StatusCode == 500)
                    {
                        <i class="bi bi-x-circle text-danger" style="font-size: 5rem;"></i>
                        <h1 class="display-1 fw-bold text-danger">500</h1>
                    }
                    else
                    {
                        <i class="bi bi-exclamation-circle text-danger" style="font-size: 5rem;"></i>
                        <h1 class="display-1 fw-bold text-danger">@Model.StatusCode</h1>
                    }
                    
                    <h2 class="mt-3">@Model.Title</h2>
                    <p class="lead text-muted mt-3">@Model.ErrorMessage</p>
                    
                    <div class="mt-4">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                            <i class="bi bi-house-door"></i> Go to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
